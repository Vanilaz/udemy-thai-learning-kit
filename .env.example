# ตั้งค่าของโปรเจกต์ — คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าที่ต้องใช้
#
# ทำไมถึงใช้ไฟล์แทน environment variable ของ Windows:
#   set   เขียนค่าลงเฉพาะหน้าต่าง Command Prompt นั้น ปิดหน้าต่างแล้วหาย
#   setx  เขียนถาวร แต่มีผลกับหน้าต่างที่เปิด "หลังจากนั้น" เท่านั้น
# ทั้งสองแบบเวลาพลาดจะหน้าตาเหมือน "ยังไม่เคยตั้งค่า" ทุกประการ
# ไฟล์นี้ไม่มีปัญหานั้น — แก้ไฟล์ แล้วเปิด start-server.cmd ใหม่ จบ
#
# ถ้าตัวแปรตัวไหนถูกตั้งไว้ใน environment จริงอยู่แล้ว ค่านั้นชนะไฟล์นี้เสมอ
# .env ถูกกันไว้ใน .gitignore แล้ว จะไม่ถูก commit
# ค่าที่ใส่ห้ามมีการแทนที่ตัวแปร ใส่ path ของ Windows ได้ตรง ๆ ไม่ต้อง escape

# --------------------------------------- เซิร์ฟเวอร์เสียงพากย์ & ASR บน Colab A100 (แนะนำ)
# การแปลซับยังใช้ `agy` ในเครื่องเหมือนเดิม ส่วนโมเดลเสียงและ Whisper ASR รันบน A100:
#   - ThonburianTTS megaF5 (อ่านศัพท์อังกฤษปนไทยชัด + โคลนเสียงผู้สอน)
#   - OpenJaiTTS v1.0 (โคลนเสียงได้ · ใบอนุญาตโมเดลห้ามใช้ทางการค้า · ต้องขอสิทธิ์ดาวน์โหลด)
#   - OmniVoice Thai & Meta SeamlessM4T-v2-large (โหมดเริ่มทันที)
#   - Typhoon Whisper Turbo & Whisper Large-v3 Turbo (ถอดความไฟล์ตัวอย่าง + สร้างซับจากเสียง)
# เปิด colab/hongrian_voice_a100.ipynb บน Colab แล้ววางบรรทัดที่พิมพ์ออกมาตรงนี้
# ถ้า A100 หลุด ระบบจะสลับไปใช้เสียงสำรองในเครื่อง (Edge Neural / Local GPU) เองโดยอัตโนมัติ
#UDTH_A100_URL=https://xxxx.trycloudflare.com
#UDTH_A100_KEY=
# สังเคราะห์เสียงล่วงหน้าแบบขนานทันทีที่ agy แปลเสร็จแต่ละท่อน
# เสียงที่สร้างล่วงหน้าคือเสียงที่ส่วนขยายใช้อยู่ ตั้งค่านี้เฉพาะเมื่อจะล็อกไว้เสียงเดียว
#UDTH_PREFETCH_VOICE=thonburian:default
#UDTH_A100_PARALLEL=6

# ------------------------------------------------ โคลนเสียงผู้สอน (Zero-shot Voice Cloning)
# ใช้ได้กับทั้ง ThonburianTTS (thonburian:clone), OpenJaiTTS (openjai:clone) และ OmniVoice (omnivoice:clone)
# ชี้ไปที่ไฟล์เสียงตัวอย่าง 5-10 วินาที
#UDTH_VOICE_REF=C:\secure\my-voice.wav
# ข้อความที่พูดในไฟล์ตัวอย่าง (ไม่ใส่ก็ได้ ระบบจะถอดความให้ครั้งแรกด้วย Typhoon Whisper แล้วจำไว้)
#UDTH_VOICE_REF_TEXT=สวัสดีครับ วันนี้เราจะมาเรียนเขียนเว็บกัน

# ---------------------------------------------------------------- เสียงพากย์อื่น ๆ
# Google Cloud Chirp 3 HD — ชี้ไปที่ไฟล์ service-account key
# ชี้ไปที่ "โฟลเดอร์" ที่เก็บ key ก็ได้ เผื่อดาวน์โหลดใหม่แล้วชื่อไฟล์เปลี่ยน
#GOOGLE_APPLICATION_CREDENTIALS=C:\secure\google-tts-key.json

# เพดานโควต้าต่อเดือน นับเป็น "ไบต์" (ของฟรีคือ 1,000,000 ดู docs/google-cloud-tts.md)
#UDTH_TTS_MONTHLY_LIMIT=900000

# OmniVoice (ใช้ตัวแปรเดิมก็ได้ หรือใช้ UDTH_VOICE_REF ด้านบนร่วมกันได้)
#UDTH_OMNIVOICE_REF=C:\secure\my-voice.wav
#UDTH_OMNIVOICE_REF_TEXT=สวัสดีครับ วันนี้เราจะมาเรียนเขียนเว็บกัน
#UDTH_OMNIVOICE_MODEL=hotdogs/omnivoice-thai

# --------------------------------------------- เสียงพากย์ AI บนการ์ดจอในเครื่อง (NVIDIA)
# โมเดล Meta SeamlessM4T — ทุกตัวพูดไทยได้ และแปลจากต้นฉบับเองได้ (T2ST)
#   facebook/hf-seamless-m4t-medium  1.2B พารามิเตอร์ ~2.5 GB VRAM  (ค่าเริ่มต้นในเครื่อง เร็วสุด)
#   facebook/hf-seamless-m4t-large   ~2.3B  ~5 GB VRAM
#   facebook/seamless-m4t-v2-large   2.3B   ~5 GB VRAM  (รุ่นใหม่สุด — รันเป็นค่าเริ่มต้นบน A100)
# เปลี่ยนแล้วเปิด start-server.cmd ใหม่ — ครั้งแรกจะดาวน์โหลดโมเดลราว 10 GB
#UDTH_SEAMLESS_MODEL=facebook/hf-seamless-m4t-medium

# โหลดโมเดลเสียงขึ้นการ์ดจอในเครื่องตั้งแต่เปิดเซิร์ฟเวอร์ (ข้ามอัตโนมัติเมื่อใช้ UDTH_A100_URL)
#   auto = โหลดทุกตัวเมื่อมีการ์ดจอ NVIDIA   off = ไม่โหลดล่วงหน้า
#   หรือระบุชื่อ เช่น omnivoice  (VRAM น้อยกว่า 8 GB แนะนำให้เลือกตัวเดียว)
#UDTH_PRELOAD=auto

# ------------------------------------------------------------------ ประสิทธิภาพการแปล (agy)
# แปลพร้อมกันกี่บทเรียน วัดแล้ว 3 ตัวได้ throughput 2.58x โดยแต่ละบทไม่ช้าลง
# 5 ตัวได้ 3.51x แต่แต่ละบทเริ่มช้าลงชัดเจน ตั้ง 1 เพื่อกลับไปทีละบท
#UDTH_WORKERS=3

# แบ่งบทเรียนเดียวเป็นกี่ท่อน วัดแล้วแทบไม่ช่วย (0.98x) และบทเรียนจริง
# เกือบทั้งหมดพอดีหนึ่งท่อนอยู่แล้ว ปกติไม่ต้องแตะ
#UDTH_PARALLEL=3

# ------------------------------------------ ตัวเลือกเสริม: แปลซับผ่าน OpenAI-compatible LLM
# ปกติไม่ต้องตั้งค่า (ใช้ agy แปลเป็นหลัก)
#UDTH_LLM_URL=https://xxxx.trycloudflare.com/v1
#UDTH_LLM_KEY=
#UDTH_LLM_MODEL=cx/gpt-5.6-luna
#UDTH_LLM_FALLBACK_MODEL=ag/gemini-3.8-flash-high
#UDTH_LLM_PARALLEL=8

# ----------------------------------------------------- เฉพาะตอนใช้ --engine claude
#ANTHROPIC_API_KEY=
#UDTH_MODEL=
#UDTH_FAST=1
#UDTH_FAST_MODEL=
