# HongRian — คัดลอกเป็น .env แล้วแก้เฉพาะค่าที่ต้องใช้
# .env เป็นไฟล์ส่วนตัวและถูก ignore โดย Git ห้ามใส่ key จริงในไฟล์ตัวอย่างนี้
# ตัวแปร environment ที่มีค่าอยู่แล้วจะชนะค่าจากไฟล์
# ใช้ path Windows ตรงๆ ได้ ไม่รองรับการแทนค่าด้วย ${VARIABLE}
# หลังแก้ .env ให้ปิดเซิร์ฟเวอร์เก่าก่อนเปิด start-server.cmd ใหม่ (เปิดเพียงตัวเดียว)
# การเลือกเสียงและภาษาเมนูอยู่ในส่วนขยาย ไม่ได้กำหนดจากไฟล์นี้

# ---------------------------------------------------------------- ค่าทั่วไป / เครื่อง VRAM น้อย
# ปิดโหลดโมเดล GPU ล่วงหน้า ใช้เสียง Edge / Niwat ในเมนูสำหรับเครื่องทั่วไป
# Edge ต้องใช้ edge-tts >= 7.3.1; หากพบ 403 ให้รัน install.cmd --no-gpu
# เครื่อง VRAM 4 GB ไม่แนะนำให้โหลดหลายโมเดลเสียงพร้อมกัน
UDTH_PRELOAD=off
UDTH_TTS_RATE=+10%
UDTH_WORKERS=3
UDTH_PARALLEL=3
# งานสร้างเสียงล่วงหน้าในเครื่อง เริ่มที่ 1 เพื่อลดการแย่งทรัพยากร
UDTH_PREFETCH_WORKERS=1

# ---------------------------------------------------------------- แปลผ่าน 9router / OpenAI-compatible API
# URL ด้านล่างเป็นตัวอย่าง ปลด # เมื่อเปิด router และตั้งค่าโมเดลแล้ว
# ถ้าไม่ตั้ง URL ระบบใช้ agy ตามเดิม ไม่จำเป็นต้องมี API key
#UDTH_LLM_URL=http://localhost:20128/v1
#UDTH_LLM_KEY=
# ใส่ ID จริงจาก router เพื่อให้ใช้โมเดลเดิมเสมอ
# ถ้าเว้นไว้ จะเลือกโมเดลตัวแรกจาก GET /v1/models ซึ่งลำดับอาจเปลี่ยนได้
#UDTH_LLM_MODEL=your-model-id
# โมเดลสำรองใน gateway เดียวกัน (ไม่จำเป็น)
#UDTH_LLM_FALLBACK_MODEL=your-fallback-model-id
UDTH_LLM_PARALLEL=3
UDTH_LLM_CHUNK_CHARS=6000
# รอบตรวจข้อความเพิ่มคำขอ API และเวลารอ ปิดด้วย 0; ไม่ใช่การตรวจเสียง
# ไม่ใช้รอบตรวจ API นี้เมื่อสลับไป agy หรือใช้ Claude
UDTH_LLM_REVIEW=1
# รองรับชื่อมาตรฐานเป็นทางเลือกด้วย แต่ UDTH_LLM_* มีลำดับก่อน
#OPENAI_BASE_URL=http://localhost:20128/v1
#OPENAI_API_KEY=
#OPENAI_MODEL=your-model-id
#OPENAI_FALLBACK_MODEL=your-fallback-model-id
# Ollama: ใช้ URL รากหรือ URL ลงท้าย /v1 ได้
#OLLAMA_HOST=http://localhost:11434
#OLLAMA_MODEL=your-model-id

# ---------------------------------------------------------------- เสียงพากย์และ ASR บน Colab A100 (ทางเลือก)
# ตัวแปลซับยังใช้ API/agy ในเครื่อง ส่วนโมเดลเสียงและ ASR รันบน A100
# เปิด colab/hongrian_voice_a100.ipynb แล้วคัดลอก URL และ key ที่โน้ตบุ๊กให้
#UDTH_A100_URL=https://xxxx.trycloudflare.com
#UDTH_A100_KEY=
#UDTH_A100_PARALLEL=6
# เสียงสำรองเมื่อ A100 ใช้งานไม่ได้
#UDTH_A100_FALLBACK_VOICE=th-TH-NiwatNeural
# ปกติสร้างเสียงล่วงหน้าตามเสียงที่ส่วนขยายเรียกใช้ ตั้งค่านี้เมื่อต้องการล็อกเสียง
#UDTH_PREFETCH_VOICE=thonburian:default

# ---------------------------------------------------------------- โคลนเสียง (ทางเลือก)
# ใช้กับ ThonburianTTS / OpenJaiTTS / OmniVoice ตัวอย่างเสียง 5–10 วินาที
#UDTH_VOICE_REF=C:\secure\my-voice.wav
#UDTH_VOICE_REF_TEXT=สวัสดีครับ วันนี้เราจะมาเรียนเขียนเว็บกัน
# ชื่อเดิมสำหรับ OmniVoice ยังใช้ได้
#UDTH_OMNIVOICE_REF=C:\secure\my-voice.wav
#UDTH_OMNIVOICE_REF_TEXT=สวัสดีครับ วันนี้เราจะมาเรียนเขียนเว็บกัน
#UDTH_OMNIVOICE_MODEL=hotdogs/omnivoice-thai

# ---------------------------------------------------------------- โมเดลในเครื่อง (ทางเลือก)
# ต้องติดตั้งแพ็กเกจ GPU แยกด้วย install.cmd --gpu และมี VRAM เพียงพอ
# เปลี่ยน UDTH_PRELOAD ด้านบนเป็น omnivoice หรือ seamless เพื่อโหลดเฉพาะตัว
# auto โหลดทุก engine ในเครื่องเมื่อพบ CUDA จึงไม่เหมาะกับการ์ด VRAM น้อย
#UDTH_SEAMLESS_MODEL=facebook/hf-seamless-m4t-medium
# ตัวเลือกอื่น: facebook/hf-seamless-m4t-large, facebook/seamless-m4t-v2-large
# ครั้งแรกต้องดาวน์โหลดโมเดล ขนาดและการใช้หน่วยความจำขึ้นกับโมเดล
#UDTH_ASR_MODEL=openai/whisper-large-v3-turbo
#UDTH_THAI_ASR_MODEL=biodatlab/whisper-th-large-v3-combined
# คำสั่ง asr ใช้กับไฟล์ที่มีอยู่ ไม่ได้ถอดเสียง Udemy อัตโนมัติ
# ตั้งก่อนรัน install.cmd เมื่อจำเป็นต้องใช้ PyTorch index อื่น
#UDTH_TORCH_INDEX=https://download.pytorch.org/whl/cu124

# ---------------------------------------------------------------- Google Cloud TTS (ทางเลือก)
# ไฟล์ service-account key หรือโฟลเดอร์ที่เก็บไฟล์ key
#GOOGLE_APPLICATION_CREDENTIALS=C:\secure\google-tts-key.json
# เพดานการใช้ต่อเดือนเป็นไบต์ ดูรายละเอียดแพ็กเกจและโควต้าที่ docs/google-cloud-tts.md
#UDTH_TTS_MONTHLY_LIMIT=900000

# ---------------------------------------------------------------- Claude API (เฉพาะเมื่อใช้ --engine claude)
#ANTHROPIC_API_KEY=
#UDTH_MODEL=
#UDTH_FAST=1
#UDTH_FAST_MODEL=

# คู่มือ: docs/translation-quality.md · docs/voices.md · INSTALL.md
# ผู้ใช้เดิม: อย่าคัดลอกทับ .env ที่มี key อยู่ ให้เพิ่มเฉพาะตัวแปรที่ต้องการ
