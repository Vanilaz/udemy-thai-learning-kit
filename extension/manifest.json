{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "version": "1.2.1",
  "description": "__MSG_description__",
  "default_locale": "en",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://www.udemy.com/*",
    "https://www.youtube.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.udemy.com/course/*",
        "https://www.youtube.com/watch*",
        "https://www.youtube.com/shorts/*"
      ],
      "js": [
        "core/i18n.js",
        "sites.js",
        "sites/udemy.js",
        "core/timeline.js",
        "core/settings.js",
        "core/api.js",
        "pipeline/dubber.js",
        "pipeline/voices.js",
        "pipeline/session.js",
        "ui/overlay.js",
        "ui/gate.js",
        "ui/menu.js",
        "modes/udemy-pages.js",
        "main.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "pot-interceptor.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
