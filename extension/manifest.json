{
  "manifest_version": 3,
  "name": "Udemy ซับไทย (AI)",
  "version": "0.1.0",
  "description": "แปลซับ Udemy เป็นไทยด้วย AI ในเครื่องคุณเอง แสดงทับบนวิดีโอ",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://www.udemy.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.udemy.com/course/*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Udemy ซับไทย"
  }
}
